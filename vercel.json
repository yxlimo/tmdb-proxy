{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "regions": ["iad1"],
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/",
            "destination": "https://github.com/yxlimo/tmdb-proxy",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/t/p/:path*",
            "destination": "https://image.tmdb.org/t/p/:path*"
        },
        {
            "source": "/t/:type/:path*",
            "destination": "https://image.tmdb.org/t/:type/:path*"
        },
        {
            "source": "/:path*",
            "destination": "/api/tmdb.js"
        }
    ]
}
