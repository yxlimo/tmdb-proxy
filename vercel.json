{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "regions": ["iad1"],
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/t/p/:path*",
            "destination": "https://image.tmdb.org/t/p/:path*"
        },
        {
            "source": "/t/:type/:path*",
            "destination": "https://image.tmdb.org/t/:type/:path*"
        },
        {
            "source": "/v2",
            "destination": "/api/docker.js"
        },
        {
            "source": "/v2/:path*",
            "destination": "/api/docker.js"
        },
        {
            "source": "/docker-health",
            "destination": "/api/docker.js"
        },
        {
            "source": "/:path*",
            "destination": "/api/tmdb.js"
        }
    ]
}
